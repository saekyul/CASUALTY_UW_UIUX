# Database Configuration
DATABASE_URL=postgresql://casualty_user:casualty_password@localhost:5432/casualty_db

# LLM API Keys
CLAUDE_API_KEY=sk-ant-your-claude-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
PREFERRED_LLM=claude

# Microsoft Outlook / Azure Configuration
OUTLOOK_CLIENT_ID=your-client-id-here
OUTLOOK_CLIENT_SECRET=your-client-secret-here
OUTLOOK_TENANT_ID=your-tenant-id-here
OUTLOOK_REDIRECT_URI=http://localhost:8000/api/auth/callback

# Application Configuration
DEBUG=true
ENV=development
SECRET_KEY=your-secret-key-here

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=3600

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
